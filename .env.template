# Provider options: local | groq | ollama | openrouter | gemini
# Default is 'local' (100% free, 0 setup, zero API keys needed)
MODEL_PROVIDER=local

# Free Groq API (High rate limits, ultra-fast Llama 3.3 70B, zero credit card)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Free Local Ollama (Runs 100% offline on your machine with 0 keys)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# System Paths & Host
CORPUS_PATH=./data/corpus
EMBEDDING_MODEL=all-MiniLM-L6-v2
HOST=0.0.0.0
PORT=8000
