# Environment
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Virtualenvs (make venv)
.venv/
venv/

# Corpus: the markdown documents are tracked, other files are not
data/corpus/*
!data/corpus/*.md
!data/corpus/.gitkeep

# Generated telemetry logs (logs/mock_run.jsonl is a tracked fixture)
logs/*.jsonl
!logs/mock_run.jsonl

# Node: dependencies for the dashboard stylesheet build, never the artifact itself
node_modules/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
